rule B3/S23
max-gen 24
num-catalyst 2
stable-interval 10
pat 2bo$b3o$o3bo$b3o$2bo! 1 1
output o_auto.rle
cat 2o$2o 100 0 0 .
cat bo$obo$bo 100 -1 -1 .
cat 2o$obo$b2o 100 -1 -1 |
cat bo$obo$obo$bo 100 -1 -2 /
cat b2o$o2bo$bobo$2bo 100 -2 -2 +
cat 2o$obo$bobo$2bo! 100 auto + locus 3bo! 0 2   # = -2 -2 + locus 3bo! -2 0; unshifted coordinates give 8 results
