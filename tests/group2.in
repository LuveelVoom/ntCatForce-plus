# group-min, group-lines, group-zone: at least one catalyst from lines 3-6, at most one
# different line from lines 1-2, which must lie in the 12x20 zone
rule B3ainj4cw5cek6n/S2-in3-ky4enyjtw5injr6cen7c
max-gen 25
num-catalyst 2
stable-interval 10
pat 2bo$b3o$o3bo$b3o$2bo! 1 1
output o_group2.rle
group-lines a 1
group-zone a 12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o$12o! 0 -10
group-min b 1
cat 2o$2o 100 0 0 . group a
cat bo$obo$bo 100 -1 -1 . group a
cat 2o$obo$b2o 100 -1 -1 | group b
cat bo$obo$obo$bo 100 -1 -2 / group b
cat b2o$o2bo$bobo$2bo 100 -2 -2 + group b
cat 2o$obo$bobo$2bo! 100 -1 -1 + group b
